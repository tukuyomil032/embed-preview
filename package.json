{
  "name": "embed-preview",
  "module": "index.ts",
  "devDependencies": {
    "@types/bun": "latest",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "vitest": "^4.1.10"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "discord.js": "^14.26.5",
    "dotenv": "^17.4.2",
    "embed-preview": ".",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "prepare": "lefthook install",
    "check": "bun run fmt:check && bun run lint:check",
    "fmt:check": "oxfmt --check",
    "fmt:fix": "oxfmt",
    "lint:check": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "dev": "bun --watch src/index.ts"
  }
}
